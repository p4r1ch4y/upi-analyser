<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      "1 taps · 1 merchants" appeared on every collapsed day. Android picks the
      form from the count, so the grammar stays right in every locale rather than
      being hand-glued from two format strings.
    -->
    <plurals name="tap_count">
        <item quantity="one">%d tap</item>
        <item quantity="other">%d taps</item>
    </plurals>
    <plurals name="merchant_count">
        <item quantity="one">%d merchant</item>
        <item quantity="other">%d merchants</item>
    </plurals>
    <!--
      No "zero" item: English has no CLDR zero form, so Android would fall
      through to "other" and print "0 days left" on the last day of a budget.
      That case is handled in code with its own string.
    -->
    <plurals name="budget_days_left">
        <item quantity="one">%d day left</item>
        <item quantity="other">%d days left</item>
    </plurals>
    <!-- The denominator line under the breakdown. "1 tags · total tagged" again. -->
    <plurals name="group_total_merchant">
        <item quantity="one">%d payee · total</item>
        <item quantity="other">%d payees · total</item>
    </plurals>
    <plurals name="group_total_tag">
        <item quantity="one">%d tag · total tagged</item>
        <item quantity="other">%d tags · total tagged</item>
    </plurals>
    <plurals name="group_total_channel">
        <item quantity="one">%d payment type · total</item>
        <item quantity="other">%d payment types · total</item>
    </plurals>
    <plurals name="rows_not_shown">
        <item quantity="one">%d smaller row not shown</item>
        <item quantity="other">%d smaller rows not shown</item>
    </plurals>
    <!--
      Counted actions. "Split 1 payments" and "Tagged 1 payments as Dinner" both
      appeared on screen, for the same reason the tap counts did: a format string
      cannot be made to agree with its own number.
    -->
    <plurals name="split_title">
        <item quantity="one">Split this payment</item>
        <item quantity="other">Split %d payments</item>
    </plurals>
    <plurals name="tag_title">
        <item quantity="one">Tag this payment</item>
        <item quantity="other">Tag %d payments</item>
    </plurals>
    <plurals name="split_applied">
        <item quantity="one">Split 1 payment</item>
        <item quantity="other">Split %d payments</item>
    </plurals>
    <plurals name="tagged_result">
        <item quantity="one">Tagged 1 payment as %2$s</item>
        <item quantity="other">Tagged %1$d payments as %2$s</item>
    </plurals>
    <plurals name="renamed_many">
        <item quantity="one">Renamed 1 payment</item>
        <item quantity="other">Renamed %d payments</item>
    </plurals>
    <plurals name="selection_count">
        <item quantity="one">1 selected</item>
        <item quantity="other">%d selected</item>
    </plurals>
</resources>
