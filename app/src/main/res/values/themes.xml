<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      This is a Compose-only app. androidx.compose.material3 ships no XML themes,
      so the activity theme parents off the platform theme rather than
      Theme.Material3.* (which lives in com.google.android.material, a dependency
      this app deliberately does not take).

      Material You dynamic color is not used anywhere - the palette is the identity.
    -->
    <style name="Theme.SpendLens" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Matches SpendColors.paper, so there is no white flash before Compose draws. -->
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      For the share receiver: invisible, but not Theme.NoDisplay.
      NoDisplay requires finish() before onResume() completes, and this activity
      has to wait for the ledger write before it can tell the user what happened.
      Translucent gives the same "no UI" feel without that contract, which
      NoDisplay enforces with a hard crash.
    -->
    <style name="Theme.SpendLens.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
