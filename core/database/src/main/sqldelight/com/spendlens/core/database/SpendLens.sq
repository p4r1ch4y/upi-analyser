-- SpendLens Database Schema
-- Never stores "Unknown" strings, uses NULL instead
-- All money amounts are integers of minor units

-- Tables are declared before the tables that reference them.

CREATE TABLE categories (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    icon TEXT,
    parent_id TEXT REFERENCES categories(id),
    is_system INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE merchants (
    id TEXT PRIMARY KEY NOT NULL,
    canonical_name TEXT NOT NULL,
    category_id TEXT REFERENCES categories(id),
    origin TEXT NOT NULL DEFAULT 'USER'  -- BUNDLED, USER, IMPORTED
);

CREATE TABLE accounts (
    id TEXT PRIMARY KEY NOT NULL,
    bank_code TEXT,
    tail4 TEXT,
    type TEXT NOT NULL,  -- SAVINGS, CREDIT_CARD, WALLET
    display_name TEXT NOT NULL,
    currency TEXT NOT NULL DEFAULT 'INR',
    created_at INTEGER NOT NULL
);

CREATE TABLE transactions (
    id TEXT PRIMARY KEY NOT NULL,
    occurred_at INTEGER NOT NULL,
    amount_minor INTEGER NOT NULL,  -- Always positive, in minor units
    currency TEXT NOT NULL,         -- ISO 4217
    direction TEXT NOT NULL,        -- DEBIT or CREDIT
    account_id TEXT REFERENCES accounts(id),
    counterparty_vpa TEXT,
    counterparty_name_raw TEXT,
    -- Resolved label. Non-null by construction: the resolution ladder always
    -- produces something, so the UI never has to render "Unknown".
    display_name TEXT NOT NULL,
    merchant_id TEXT REFERENCES merchants(id),
    category_id TEXT REFERENCES categories(id),
    confidence REAL NOT NULL DEFAULT 0.0,
    resolution_rung INTEGER NOT NULL DEFAULT 6,
    source_mask INTEGER NOT NULL DEFAULT 0,
    rrn TEXT,
    channel TEXT,          -- UPI, CARD, NEFT, etc
    instrument TEXT,       -- SAVINGS, CREDIT_CARD, WALLET
    flags INTEGER NOT NULL DEFAULT 0,
    linked_txn_id TEXT REFERENCES transactions(id),
    note TEXT,
    template_id TEXT,      -- Which parser rule produced this
    body_hash TEXT,        -- Source message hash, for tracing a dedupe decision
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE TABLE vpa_rules (
    id TEXT PRIMARY KEY NOT NULL,
    pattern TEXT NOT NULL,
    match_type TEXT NOT NULL,  -- EXACT, PREFIX, REGEX
    merchant_id TEXT REFERENCES merchants(id),
    merchant_name TEXT NOT NULL,
    category_id TEXT REFERENCES categories(id),
    priority INTEGER NOT NULL DEFAULT 0,
    origin TEXT NOT NULL DEFAULT 'USER',
    created_at INTEGER NOT NULL
);

CREATE TABLE budgets (
    id TEXT PRIMARY KEY NOT NULL,
    category_id TEXT REFERENCES categories(id),
    period TEXT NOT NULL,  -- WEEKLY, MONTHLY, CUSTOM
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'INR',
    starts_at INTEGER NOT NULL
);

CREATE TABLE splits (
    id TEXT PRIMARY KEY NOT NULL,
    txn_id TEXT NOT NULL REFERENCES transactions(id),
    total_minor INTEGER NOT NULL,
    my_share_minor INTEGER NOT NULL,
    settled_minor INTEGER NOT NULL DEFAULT 0
);

-- A label the user puts on a payment.
--
-- A TRIP owns a date range, which is what lets the home screen show "Goa trip,
-- day 3 of 5" and lets a whole stretch of days be claimed at once. A PLAIN tag is
-- just a label. One table, because a trip is a tag that happens to know its dates
-- - splitting them apart would duplicate every join for no gain.
CREATE TABLE tags (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    kind TEXT NOT NULL DEFAULT 'PLAIN',   -- PLAIN, TRIP
    starts_at INTEGER,                    -- TRIP only
    ends_at INTEGER,                      -- TRIP only
    created_at INTEGER NOT NULL
);

CREATE UNIQUE INDEX idx_tags_name ON tags(name);

CREATE TABLE transaction_tags (
    txn_id TEXT NOT NULL REFERENCES transactions(id),
    tag_id TEXT NOT NULL REFERENCES tags(id),
    PRIMARY KEY (txn_id, tag_id)
);

CREATE INDEX idx_txn_tags_tag ON transaction_tags(tag_id);

-- Who owes what on a split payment.
--
-- Shares are stored per person rather than derived from a "split N ways" count,
-- because they stop being even the moment someone settles up or the user edits
-- one. settled_at is null until they actually pay you back.
CREATE TABLE split_participants (
    id TEXT PRIMARY KEY NOT NULL,
    split_id TEXT NOT NULL REFERENCES splits(id),
    name TEXT NOT NULL,
    share_minor INTEGER NOT NULL,
    is_me INTEGER NOT NULL DEFAULT 0,
    settled_at INTEGER
);

CREATE INDEX idx_split_participants ON split_participants(split_id);

-- The message a transaction was read out of, kept verbatim.
--
-- A separate table rather than a column, because one transaction can legitimately
-- have several sources: a payment seen as a UPI notification and again as a bank
-- SMS is one row in `transactions`, and both messages are worth keeping. The
-- ledger says what the app concluded; this says what it was told.
CREATE TABLE source_messages (
    id TEXT PRIMARY KEY NOT NULL,
    txn_id TEXT NOT NULL REFERENCES transactions(id),
    source TEXT NOT NULL,        -- NOTIFICATION, SMS, STATEMENT, MANUAL
    origin TEXT,                 -- package name, SMS sender ID, or file name
    body TEXT NOT NULL,
    received_at INTEGER NOT NULL,
    template_id TEXT             -- the rule that matched, for tracing a misparse
);

CREATE INDEX idx_source_messages_txn ON source_messages(txn_id);

CREATE TABLE seen_hashes (
    body_hash TEXT PRIMARY KEY NOT NULL,
    seen_at INTEGER NOT NULL
);

-- Indexes for performance
CREATE INDEX idx_txn_occurred ON transactions(occurred_at DESC);
CREATE INDEX idx_txn_vpa ON transactions(counterparty_vpa);
CREATE INDEX idx_txn_rrn ON transactions(rrn);
CREATE INDEX idx_txn_merchant ON transactions(merchant_id, occurred_at DESC);
CREATE INDEX idx_txn_category ON transactions(category_id, occurred_at DESC);
CREATE INDEX idx_seen_hashes_time ON seen_hashes(seen_at);
CREATE INDEX idx_splits_txn ON splits(txn_id);

-- Queries
selectAllTransactions:
SELECT * FROM transactions
WHERE deleted_at IS NULL
ORDER BY occurred_at DESC
LIMIT :limit OFFSET :offset;

selectTransactionById:
SELECT * FROM transactions WHERE id = :id AND deleted_at IS NULL;

selectTransactionsByDateRange:
SELECT * FROM transactions
WHERE occurred_at >= :startTime
  AND occurred_at < :endTime
  AND deleted_at IS NULL
ORDER BY occurred_at DESC;

selectTransactionsSince:
SELECT * FROM transactions
WHERE occurred_at >= :since
  AND deleted_at IS NULL
ORDER BY occurred_at DESC;

-- Fusion candidates: same money, same direction, a moment either side.
selectFusionCandidates:
SELECT * FROM transactions
WHERE amount_minor = :amountMinor
  AND currency = :currency
  AND direction = :direction
  AND occurred_at BETWEEN :windowStart AND :windowEnd
  AND deleted_at IS NULL
ORDER BY occurred_at DESC;

selectByRrn:
SELECT * FROM transactions
WHERE rrn = :rrn AND deleted_at IS NULL
LIMIT 1;

insertTransaction:
INSERT INTO transactions (
    id, occurred_at, amount_minor, currency, direction,
    account_id, counterparty_vpa, counterparty_name_raw, display_name,
    merchant_id, category_id, confidence, resolution_rung,
    source_mask, rrn, channel, instrument, flags,
    linked_txn_id, note, template_id, body_hash,
    created_at, updated_at, deleted_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTransaction:
UPDATE transactions
SET occurred_at = :occurred_at,
    merchant_id = :merchant_id,
    category_id = :category_id,
    note = :note,
    updated_at = :updated_at
WHERE id = :id;

-- Applied when a fused sibling arrives on a second rail: fill in the fields the
-- new source is more trusted for, and record it in the source mask.
mergeIntoTransaction:
UPDATE transactions
SET counterparty_vpa = coalesce(:counterparty_vpa, counterparty_vpa),
    counterparty_name_raw = coalesce(:counterparty_name_raw, counterparty_name_raw),
    display_name = :display_name,
    rrn = coalesce(:rrn, rrn),
    source_mask = source_mask | :source_bit,
    confidence = max(confidence, :confidence),
    updated_at = :updated_at
WHERE id = :id;

-- User correction: retroactively relabel every past payment to this VPA.
relabelByVpa:
UPDATE transactions
SET display_name = :display_name,
    merchant_id = :merchant_id,
    category_id = :category_id,
    resolution_rung = 1,
    confidence = 1.0,
    flags = flags | 64,          -- FLAG_MANUAL_EDIT
    updated_at = :updated_at
WHERE counterparty_vpa = :vpa AND deleted_at IS NULL;

softDeleteTransaction:
UPDATE transactions
SET deleted_at = :deleted_at,
    updated_at = :updated_at
WHERE id = :id;

-- VPA Rules
selectVpaRules:
SELECT * FROM vpa_rules ORDER BY priority DESC;

insertVpaRule:
INSERT OR REPLACE INTO vpa_rules (id, pattern, match_type, merchant_id, merchant_name, category_id, priority, origin, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteVpaRule:
DELETE FROM vpa_rules WHERE id = :id;

-- Merchants
selectMerchantById:
SELECT * FROM merchants WHERE id = :id;

insertMerchant:
INSERT OR REPLACE INTO merchants (id, canonical_name, category_id, origin)
VALUES (?, ?, ?, ?);

-- Categories
selectAllCategories:
SELECT * FROM categories ORDER BY name;

insertCategory:
INSERT OR IGNORE INTO categories (id, name, icon, parent_id, is_system)
VALUES (?, ?, ?, ?, ?);

-- Seen hashes (for deduplication)
isHashSeen:
SELECT 1 FROM seen_hashes WHERE body_hash = :hash LIMIT 1;

insertSeenHash:
INSERT OR IGNORE INTO seen_hashes (body_hash, seen_at) VALUES (?, ?);

pruneOldHashes:
DELETE FROM seen_hashes WHERE seen_at < :cutoffTime;

-- Aggregations
selectDayTotal:
SELECT SUM(amount_minor) AS total_minor
FROM transactions
WHERE occurred_at >= :dayStart
  AND occurred_at < :dayEnd
  AND direction = 'DEBIT'
  AND (flags & 8) = 0    -- FLAG_EXCLUDED
  AND (flags & 128) = 0  -- FLAG_FAILED: attempted, but the money never moved
  AND deleted_at IS NULL;

selectDayStats:
SELECT
    COUNT(*) AS transaction_count,
    COUNT(DISTINCT display_name) AS merchant_count,
    SUM(amount_minor) AS total_minor
FROM transactions
WHERE occurred_at >= :dayStart
  AND occurred_at < :dayEnd
  AND direction = 'DEBIT'
  AND (flags & 8) = 0
  AND deleted_at IS NULL;


-- Splits ---------------------------------------------------------------------

selectSplitForTxn:
SELECT * FROM splits WHERE txn_id = :txnId LIMIT 1;

selectSplitParticipants:
SELECT * FROM split_participants WHERE split_id = :splitId ORDER BY is_me DESC, rowid;

-- Every split in a window, for the day stream and the dashboard. Joined to the
-- transaction so one query answers "what did I actually pay, and what was mine".
selectSplitsSince:
SELECT s.*, t.occurred_at
FROM splits s
JOIN transactions t ON t.id = s.txn_id
WHERE t.occurred_at >= :since AND t.deleted_at IS NULL;

insertSplit:
INSERT OR REPLACE INTO splits (id, txn_id, total_minor, my_share_minor, settled_minor)
VALUES (?, ?, ?, ?, ?);

insertSplitParticipant:
INSERT INTO split_participants (id, split_id, name, share_minor, is_me, settled_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteSplitParticipants:
DELETE FROM split_participants WHERE split_id = :splitId;

deleteSplit:
DELETE FROM splits WHERE txn_id = :txnId;

setParticipantSettled:
UPDATE split_participants SET settled_at = :settledAt WHERE id = :id;

updateSplitSettled:
UPDATE splits SET settled_minor = :settledMinor WHERE id = :id;

-- Tags -----------------------------------------------------------------------

selectAllTags:
SELECT * FROM tags ORDER BY kind DESC, name;

selectTagsForTxn:
SELECT tg.* FROM tags tg
JOIN transaction_tags tt ON tt.tag_id = tg.id
WHERE tt.txn_id = :txnId
ORDER BY tg.kind DESC, tg.name;

-- Every (transaction, tag) pair in a window, so the stream can label rows without
-- one query per row.
selectTagLinksSince:
SELECT tt.txn_id, tg.id, tg.name, tg.kind
FROM transaction_tags tt
JOIN tags tg ON tg.id = tt.tag_id
JOIN transactions t ON t.id = tt.txn_id
WHERE t.occurred_at >= :since AND t.deleted_at IS NULL;

-- The trip covering an instant, if any. Used for the home screen banner.
selectTripAt:
SELECT * FROM tags
WHERE kind = 'TRIP' AND starts_at <= :at AND ends_at >= :at
ORDER BY starts_at DESC
LIMIT 1;

insertTag:
INSERT OR IGNORE INTO tags (id, name, kind, starts_at, ends_at, created_at)
VALUES (?, ?, ?, ?, ?, ?);

selectTagByName:
SELECT * FROM tags WHERE name = :name LIMIT 1;

tagTransaction:
INSERT OR IGNORE INTO transaction_tags (txn_id, tag_id) VALUES (?, ?);

untagTransaction:
DELETE FROM transaction_tags WHERE txn_id = :txnId AND tag_id = :tagId;

deleteTag:
DELETE FROM tags WHERE id = :id;

deleteTagLinks:
DELETE FROM transaction_tags WHERE tag_id = :tagId;

-- Analytics ------------------------------------------------------------------

-- Spend by counterparty over a window. `effective_minor` is the user's own cost:
-- their share when a payment was split, the full amount otherwise. Reporting the
-- gross would tell someone who fronted a group dinner that they spent ₹8,000 on
-- food, which is both wrong and the reason they stop trusting the number.
selectSpendByMerchant:
SELECT t.display_name AS label,
       SUM(coalesce(s.my_share_minor, t.amount_minor)) AS effective_minor,
       COUNT(*) AS txn_count
FROM transactions t
LEFT JOIN splits s ON s.txn_id = t.id
WHERE t.occurred_at >= :since AND t.occurred_at < :until
  AND t.direction = :direction AND t.deleted_at IS NULL
  AND (t.flags & 128) = 0
GROUP BY t.display_name
ORDER BY effective_minor DESC
LIMIT :limit;

selectSpendByChannel:
SELECT coalesce(t.channel, 'UNKNOWN') AS label,
       SUM(coalesce(s.my_share_minor, t.amount_minor)) AS effective_minor,
       COUNT(*) AS txn_count
FROM transactions t
LEFT JOIN splits s ON s.txn_id = t.id
WHERE t.occurred_at >= :since AND t.occurred_at < :until
  AND t.direction = :direction AND t.deleted_at IS NULL
  AND (t.flags & 128) = 0
GROUP BY label
ORDER BY effective_minor DESC;

selectSpendByTag:
SELECT tg.name AS label,
       SUM(coalesce(s.my_share_minor, t.amount_minor)) AS effective_minor,
       COUNT(*) AS txn_count
FROM transactions t
JOIN transaction_tags tt ON tt.txn_id = t.id
JOIN tags tg ON tg.id = tt.tag_id
LEFT JOIN splits s ON s.txn_id = t.id
WHERE t.occurred_at >= :since AND t.occurred_at < :until
  AND t.direction = :direction AND t.deleted_at IS NULL
  AND (t.flags & 128) = 0
GROUP BY tg.name
ORDER BY effective_minor DESC
LIMIT :limit;

-- One row per transaction, already reduced to what the user actually spent.
-- Bucketing into days happens in Kotlin, where the time zone is known; SQLite
-- would have to be told the offset and would get it wrong across a DST change.
selectSpendPointsSince:
SELECT t.occurred_at,
       t.direction,
       coalesce(s.my_share_minor, t.amount_minor) AS effective_minor
FROM transactions t
LEFT JOIN splits s ON s.txn_id = t.id
WHERE t.occurred_at >= :since AND t.occurred_at < :until
  AND t.deleted_at IS NULL
  AND (t.flags & 128) = 0
ORDER BY t.occurred_at;

-- One-off label repair -------------------------------------------------------
--
-- An earlier build's resolution ladder fell back to the literal string
-- "Manual entry" for any payment whose counterparty it could not recover, which
-- labelled hundreds of imported bank messages as something the user had typed in
-- by hand. Source mask 8 is MANUAL, so these are precisely the rows that were
-- never manual.

repairFalseManualLabels:
UPDATE transactions
SET display_name = coalesce(counterparty_name_raw, 'Bank message'),
    updated_at = :now
WHERE display_name = 'Manual entry'
  AND (source_mask & 8) = 0
  AND deleted_at IS NULL;

-- The same ladder ignored counterparty names captured from SMS and fell through
-- to the VPA, rendering a Google Play mandate as its 32-character hash. Where a
-- real name was captured and something worse was stored, prefer the name.
repairIgnoredCapturedNames:
UPDATE transactions
SET display_name = counterparty_name_raw,
    resolution_rung = 2,
    updated_at = :now
WHERE counterparty_name_raw IS NOT NULL
  AND counterparty_name_raw != display_name
  AND counterparty_name_raw NOT LIKE '%@%'
  AND resolution_rung >= 3
  AND (source_mask & 2) != 0
  AND deleted_at IS NULL;

-- Source messages ------------------------------------------------------------

selectSourceMessages:
SELECT * FROM source_messages WHERE txn_id = :txnId ORDER BY received_at;

insertSourceMessage:
INSERT INTO source_messages (id, txn_id, source, origin, body, received_at, template_id)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSourceMessagesFor:
DELETE FROM source_messages WHERE txn_id = :txnId;

-- Rename one transaction. Used when the message named no payee and only the user
-- can say what it was, so there is no rule to replay - just this row.
renameTransaction:
UPDATE transactions
SET display_name = :display_name,
    resolution_rung = 1,
    confidence = 1.0,
    flags = flags | 64,          -- FLAG_MANUAL_EDIT
    updated_at = :updated_at
WHERE id = :id;

-- Rows whose label is a generic placeholder, but whose source message names the
-- bank that moved the money. Display names are resolved once and stored, so
-- teaching the resolver to read the institution does nothing for the 82% of rows
-- already sitting in the ledger saying "Bank message".
selectRelabelCandidates:
SELECT t.id, t.display_name, s.source, s.origin, s.body, s.received_at
FROM transactions t
JOIN source_messages s ON s.txn_id = t.id
WHERE t.display_name IN ('Bank message', 'Payment', 'Statement entry')
  AND (t.flags & 64) = 0        -- never overwrite a name the user chose
  AND t.deleted_at IS NULL
GROUP BY t.id;

relabelTransaction:
UPDATE transactions
SET display_name = :display_name, updated_at = :updated_at
WHERE id = :id AND (flags & 64) = 0;

-- How many other payments share this one's label and amount.
--
-- Bank SMS that names no payee produces hundreds of rows reading the same thing,
-- and they cluster hard by amount: in six months of one real ledger, 442 of 581
-- unnamed rows sat in a group of three or more. The daily ₹10 is one recurring
-- thing; naming it once should not mean opening 105 sheets.
countSimilarTransactions:
SELECT COUNT(*) AS similar_count
FROM transactions
WHERE display_name = :display_name
  AND amount_minor = :amount_minor
  AND direction = :direction
  AND (flags & 64) = 0        -- never touch a row the user already named
  AND deleted_at IS NULL;

renameSimilarTransactions:
UPDATE transactions
SET display_name = :new_name,
    resolution_rung = 1,
    confidence = 1.0,
    flags = flags | 64,
    updated_at = :updated_at
WHERE display_name = :display_name
  AND amount_minor = :amount_minor
  AND direction = :direction
  AND (flags & 64) = 0
  AND deleted_at IS NULL;

-- The note a user attaches after the fact.
--
-- UPI apps let you type a remark when paying, but that remark never reaches the
-- notification or the SMS - it stays inside the payment app. This is where it
-- comes back, typed once by the person who already knows what it was for.
setTransactionNote:
UPDATE transactions
SET note = :note, updated_at = :updated_at
WHERE id = :id;

selectMostRecentTransaction:
SELECT * FROM transactions
WHERE deleted_at IS NULL
ORDER BY occurred_at DESC
LIMIT 1;
