# Copy to keystore.properties and fill in. That file is git-ignored; this one is
# committed so it is obvious what the build expects.
#
# Create the key once, and keep both it and these passwords somewhere you will
# still have them in five years — an app signed with a different key than the
# last release cannot be installed as an update, only as a fresh install, and
# every user loses their ledger:
#
#   keytool -genkeypair -v \
#     -keystore spendlens-release.jks \
#     -alias spendlens \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Without keystore.properties the release build is left UNSIGNED. That is
# deliberate: the previous behaviour was to fall back to the debug key, whose
# private half ships inside the Android SDK and is identical on every machine
# in the world.

storeFile=spendlens-release.jks
storePassword=
keyAlias=spendlens
keyPassword=
